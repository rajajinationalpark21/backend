# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins. In development, when this is
# left empty, any origin is accepted so Vite dev servers work out of the box.
# In production this list is enforced strictly.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas example:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/jungle_safari
MONGODB_URI=mongodb://127.0.0.1:27017/jungle_safari

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Use a long random string, e.g. `openssl rand -hex 48`.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seed credentials used by `npm run seed` to create the admin panel login.
ADMIN_NAME=Dr Chaturbhuj
ADMIN_EMAIL=admin@junglesafari.com
ADMIN_PASSWORD=ChangeMe123!

# ── Cloudinary (image storage) ────────────────────────────────────────────────
# All three are required for blog covers, gallery photos and hero banners.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jungle-safari

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_REQUEST=12
